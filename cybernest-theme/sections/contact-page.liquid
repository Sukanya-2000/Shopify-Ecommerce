{{ 'contact.css' | asset_url | stylesheet_tag }}

<section class="page-section contact-page">
  <div class="container">
    <div class="contact-page__grid">
      <div class="contact-page__details stack">
        <span class="badge">Support</span>
        <h1>{{ section.settings.heading }}</h1>
        <p class="contact-page__intro">{{ section.settings.intro }}</p>

        <div class="contact-page__info">
          <div>
            <span>Email</span>
            <a href="mailto:{{ section.settings.email }}">{{ section.settings.email }}</a>
          </div>
          <div>
            <span>Phone</span>
            <a href="tel:{{ section.settings.phone | remove: ' ' | remove: '(' | remove: ')' | remove: '-' }}">{{ section.settings.phone }}</a>
          </div>
          <div>
            <span>Address</span>
            <p>{{ section.settings.address }}</p>
          </div>
          <div>
            <span>Hours</span>
            <p>{{ section.settings.hours }}</p>
          </div>
        </div>
      </div>

      <div class="contact-page__form-wrap">
        {% form 'contact', class: 'contact-form' %}
          {%- if form.posted_successfully? -%}
            <p class="contact-form__message" tabindex="-1" autofocus>Thanks for reaching out. We will reply shortly.</p>
          {%- endif -%}

          {%- if form.errors -%}
            <div class="contact-form__message contact-form__message--error">
              {{ form.errors | default_errors }}
            </div>
          {%- endif -%}

          <div class="contact-form__row">
            <div>
              <label for="ContactName-{{ section.id }}">Name</label>
              <input id="ContactName-{{ section.id }}" class="input" type="text" name="contact[name]" value="{{ form.name }}" autocomplete="name" required>
            </div>
            <div>
              <label for="ContactEmail-{{ section.id }}">Email</label>
              <input id="ContactEmail-{{ section.id }}" class="input" type="email" name="contact[email]" value="{{ form.email }}" autocomplete="email" required>
            </div>
          </div>

          <div>
            <label for="ContactPhone-{{ section.id }}">Phone</label>
            <input id="ContactPhone-{{ section.id }}" class="input" type="tel" name="contact[phone]" value="{{ form.phone }}" autocomplete="tel">
          </div>

          <div>
            <label for="ContactReason-{{ section.id }}">Reason</label>
            <select id="ContactReason-{{ section.id }}" class="input" name="contact[reason]">
              <option value="Product question">Product question</option>
              <option value="Order support">Order support</option>
              <option value="Returns">Returns</option>
              <option value="Business inquiry">Business inquiry</option>
            </select>
          </div>

          <div>
            <label for="ContactMessage-{{ section.id }}">Message</label>
            <textarea id="ContactMessage-{{ section.id }}" class="input contact-form__textarea" name="contact[body]" required>{{ form.body }}</textarea>
          </div>

          <button class="btn" type="submit">Send message</button>
        {% endform %}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Contact page",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Contact CyberNest"
    },
    {
      "type": "textarea",
      "id": "intro",
      "label": "Intro",
      "default": "Need help choosing gear, tracking an order, or planning a setup? Send us a note and our support team will get back to you."
    },
    {
      "type": "text",
      "id": "email",
      "label": "Email",
      "default": "support@cybernest.example"
    },
    {
      "type": "text",
      "id": "phone",
      "label": "Phone",
      "default": "+1 (555) 014-2048"
    },
    {
      "type": "textarea",
      "id": "address",
      "label": "Address",
      "default": "245 Market Street, Suite 640, San Francisco, CA 94105"
    },
    {
      "type": "text",
      "id": "hours",
      "label": "Hours",
      "default": "Monday to Friday, 9:00 AM - 6:00 PM PT"
    }
  ],
  "presets": [
    {
      "name": "Contact page"
    }
  ]
}
{% endschema %}
