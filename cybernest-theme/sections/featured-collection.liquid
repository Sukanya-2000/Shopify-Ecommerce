{%- assign featured_collection = collections[section.settings.collection] -%}

<section class="page-section">
  <div class="container">
    <div class="section-heading">
      {%- if section.settings.heading != blank -%}
        <h2>{{ section.settings.heading }}</h2>
      {%- endif -%}
    </div>
    {%- if featured_collection != blank and featured_collection.products_count > 0 -%}
      <div class="product-grid">
        {%- for product in featured_collection.products limit: section.settings.count -%}
          {% render 'product-card', product: product %}
        {%- endfor -%}
      </div>
    {%- else -%}
      <p class="featured-collection__empty">Choose a collection with products to populate this section.</p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Featured collection",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Featured collection"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "count",
      "label": "Product count",
      "min": 4,
      "max": 16,
      "step": 2,
      "default": 8
    }
  ],
  "presets": [
    {
      "name": "Featured collection"
    }
  ]
}
{% endschema %}
