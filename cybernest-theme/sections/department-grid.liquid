<section class="page-section">
  <div class="container">
    {%- if section.settings.heading != blank -%}
      <div class="section-heading">
        <h2>{{ section.settings.heading }}</h2>
      </div>
    {%- endif -%}
    <div class="department-grid">
      {%- for block in section.blocks -%}
        <a class="department-card" href="{{ block.settings.link | default: routes.all_products_collection_url }}" {{ block.shopify_attributes }}>
          <div class="department-card__media">
            {%- if block.settings.image != blank -%}
              {{
                block.settings.image
                | image_url: width: 640
                | image_tag:
                  loading: 'lazy',
                  widths: '320, 480, 640',
                  sizes: '(min-width: 72em) 16vw, (min-width: 48em) 25vw, 50vw',
                  alt: block.settings.title
              }}
            {%- endif -%}
          </div>
          {%- if block.settings.title != blank -%}
            <span class="department-card__title">{{ block.settings.title }}</span>
          {%- endif -%}
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Department grid",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop by department"
    }
  ],
  "blocks": [
    {
      "type": "department",
      "name": "Department",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Department"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Department grid",
      "blocks": [
        {
          "type": "department"
        },
        {
          "type": "department"
        },
        {
          "type": "department"
        },
        {
          "type": "department"
        }
      ]
    }
  ]
}
{% endschema %}
