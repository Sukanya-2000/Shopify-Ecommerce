<main class="page-section collection-page" data-local-catalog data-api-base="http://localhost:5000/api">
  <div class="container">
    <header class="collection-page__header">
      <div class="stack">
        <span class="badge" data-local-catalog-count>{{ collection.products_count }} products</span>
        <h1>{{ collection.title | default: 'Catalog' }}</h1>

        {% if collection.description != blank %}
          <div class="collection-page__description">{{ collection.description }}</div>
        {% else %}
          <p class="collection-page__description">
            Browse smart home essentials, desk upgrades, audio gear, chargers, accessories, and everyday tech selected for CyberNest.
          </p>
        {% endif %}
      </div>
    </header>

    {% if collection.products_count > 0 %}
      <div class="collection-page__local-toolbar" aria-label="Local catalog controls">
        <label class="collection-page__search">
          <span>Search</span>
          <input class="input" type="search" placeholder="Search products" data-local-catalog-search>
        </label>
        <label class="collection-page__select">
          <span>Department</span>
          <select class="input" data-local-catalog-type>
            <option value="">All departments</option>
          </select>
        </label>
        <label class="collection-page__select">
          <span>Category</span>
          <select class="input" data-local-catalog-category>
            <option value="">All categories</option>
          </select>
        </label>
        <label class="collection-page__select">
          <span>Availability</span>
          <select class="input" data-local-catalog-availability>
            <option value="">All stock</option>
            <option value="available">Available</option>
            <option value="sold-out">Sold out</option>
          </select>
        </label>
        <label class="collection-page__select">
          <span>Sort</span>
          <select class="input" data-local-catalog-sort>
            <option value="title-ascending">Alphabetically, A-Z</option>
            <option value="title-descending">Alphabetically, Z-A</option>
            <option value="price-ascending">Price, low to high</option>
            <option value="price-descending">Price, high to low</option>
            <option value="created-descending">Newest</option>
          </select>
        </label>
        <label class="collection-page__select">
          <span>Items per page</span>
          <select class="input" data-local-catalog-page-size>
            <option value="8">8 products</option>
            <option value="12" selected>12 products</option>
            <option value="16">16 products</option>
            <option value="24">24 products</option>
            <option value="36">36 products</option>
          </select>
        </label>
        <label class="collection-page__select">
          <span>Items per row</span>
          <select class="input" data-local-catalog-columns>
            <option value="2">2 per row</option>
            <option value="3">3 per row</option>
            <option value="4" selected>4 per row</option>
            <option value="5">5 per row</option>
          </select>
        </label>
        <p class="collection-page__local-status" data-local-catalog-status></p>
      </div>

      <form class="collection-page__toolbar" id="CollectionFilters" method="get">
        {%- if collection.filters != blank -%}
          <div class="collection-page__filters">
            {%- for filter in collection.filters -%}
              {%- if filter.type == 'list' -%}
                <details class="collection-filter">
                  <summary>{{ filter.label }}</summary>
                  <div class="collection-filter__options">
                    {%- for value in filter.values -%}
                      <label>
                        <input
                          type="checkbox"
                          name="{{ value.param_name }}"
                          value="{{ value.value }}"
                          {% if value.active %}checked{% endif %}
                          {% if value.count == 0 and value.active == false %}disabled{% endif %}
                        >
                        <span>{{ value.label }} ({{ value.count }})</span>
                      </label>
                    {%- endfor -%}
                  </div>
                </details>
              {%- endif -%}
            {%- endfor -%}
            <button class="btn btn--sm" type="submit">Apply</button>
          </div>
        {%- endif -%}

        <label class="collection-page__sort">
          <span>Sort</span>
          <select class="input" name="sort_by" onchange="this.form.submit()">
            {%- assign sort_by = collection.sort_by | default: collection.default_sort_by -%}
            {%- for option in collection.sort_options -%}
              <option value="{{ option.value }}" {% if option.value == sort_by %}selected{% endif %}>{{ option.name }}</option>
            {%- endfor -%}
          </select>
        </label>
      </form>

      <div
        class="product-grid product-grid--catalog"
        data-local-catalog-grid
        style="--catalog-columns: {{ section.settings.products_per_row }};"
      >
        {% paginate collection.products by section.settings.products_per_page %}
          {% for product in collection.products %}
            {% render 'product-card', product: product, show_description: true %}
          {% endfor %}

          {% if paginate.pages > 1 %}
            <div class="collection-page__pagination">
              {% render 'pagination', paginate: paginate %}
            </div>
          {% endif %}
        {% endpaginate %}
      </div>
      <div class="collection-page__local-pagination" data-local-catalog-pagination hidden></div>
    {% else %}
      <div class="collection-page__empty stack">
        <h2>No products found</h2>
        <p>Add products to this collection in Shopify Admin or import the sample catalog from data/sample-products.csv.</p>
        <a class="btn" href="{{ routes.all_products_collection_url }}">View all products</a>
      </div>
    {% endif %}
  </div>
</main>

{% schema %}
{
  "name": "Main collection",
  "settings": [
    {
      "type": "range",
      "id": "products_per_page",
      "label": "Products per page",
      "min": 12,
      "max": 48,
      "step": 4,
      "default": 24
    },
    {
      "type": "range",
      "id": "products_per_row",
      "label": "Products per row",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 4
    }
  ]
}
{% endschema %}
