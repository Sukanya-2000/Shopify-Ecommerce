<main class="page-section">
  <div class="container stack">
    <h1>Your cart</h1>

    {% if cart.item_count > 0 %}
      <form action="{{ routes.cart_url }}" method="post" class="stack">
        {% for item in cart.items %}
          <div class="grid">
            <div class="col-8">
              <a href="{{ item.url }}">{{ item.product.title }}</a>
              <p>{{ item.final_line_price | money }}</p>
            </div>
            <div class="col-4">
              <input
                class="input"
                type="number"
                name="updates[]"
                value="{{ item.quantity }}"
                min="0"
                aria-label="Quantity for {{ item.product.title | escape }}"
              >
            </div>
          </div>
        {% endfor %}

        <p>Total: {{ cart.total_price | money }}</p>
        <button class="btn btn--secondary" type="submit" name="update">Update cart</button>
        <button class="btn" type="submit" name="checkout">Checkout</button>
      </form>
    {% else %}
      <p>Your cart is empty.</p>
      <a class="btn" href="{{ routes.all_products_collection_url }}">Start shopping</a>
    {% endif %}
  </div>
</main>

{% schema %}
{
  "name": "Main cart"
}
{% endschema %}
