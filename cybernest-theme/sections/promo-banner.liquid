<section class="promo-banner">
  {%- if section.settings.image != blank -%}
    <div class="promo-banner__media">
      {{
        section.settings.image
        | image_url: width: 2000
        | image_tag:
          loading: 'lazy',
          widths: '720, 1200, 1600, 2000',
          sizes: '100vw',
          alt: section.settings.heading
      }}
    </div>
  {%- endif -%}
  <div class="container">
    <div class="promo-banner__content stack">
      {%- if section.settings.heading != blank -%}
        <h2>{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.subtext != blank -%}
        <div class="promo-banner__text">{{ section.settings.subtext }}</div>
      {%- endif -%}
      {%- if section.settings.cta_text != blank and section.settings.cta_link != blank -%}
        <div>
          <a class="btn" href="{{ section.settings.cta_link }}">{{ section.settings.cta_text }}</a>
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Promo banner",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Limited-time tech upgrades"
    },
    {
      "type": "richtext",
      "id": "subtext",
      "label": "Subtext",
      "default": "<p>Build your setup with curated accessories, devices, and daily-use gear.</p>"
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "CTA text",
      "default": "Shop now"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "CTA link"
    }
  ],
  "presets": [
    {
      "name": "Promo banner"
    }
  ]
}
{% endschema %}
