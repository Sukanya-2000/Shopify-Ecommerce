<section class="page-section" data-local-brands>
  <div class="container">
    {%- if section.settings.heading != blank -%}
      <div class="section-heading">
        <h2>{{ section.settings.heading }}</h2>
      </div>
    {%- endif -%}
    <div class="brand-logos" aria-label="Featured brands" data-local-brands-grid>
      {%- for block in section.blocks -%}
        <a class="brand-logo" href="{{ block.settings.link | default: routes.root_url }}" {{ block.shopify_attributes }}>
          <span class="brand-logo__image">
            {%- if block.settings.logo != blank -%}
              {{
                block.settings.logo
                | image_url: width: 320
                | image_tag:
                  loading: 'lazy',
                  widths: '160, 240, 320',
                  sizes: '160px',
                  alt: 'Brand logo'
              }}
            {%- else -%}
              <span class="brand-logo__fallback">CN</span>
            {%- endif -%}
          </span>
          <span class="brand-logo__name">CyberNest</span>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Brand logos",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Featured brands"
    }
  ],
  "blocks": [
    {
      "type": "brand",
      "name": "Brand",
      "settings": [
        {
          "type": "image_picker",
          "id": "logo",
          "label": "Logo"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Brand logos",
      "blocks": [
        {
          "type": "brand"
        },
        {
          "type": "brand"
        },
        {
          "type": "brand"
        },
        {
          "type": "brand"
        }
      ]
    }
  ]
}
{% endschema %}
