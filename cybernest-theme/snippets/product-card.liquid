<article class="product-card">
  <a class="product-card__link stack" href="{{ product.url }}">
    <div class="product-card__media">
      {%- if product.featured_image -%}
        {{
          product.featured_image
          | image_url: width: 640
          | image_tag:
            loading: 'lazy',
            widths: '320, 480, 640',
            sizes: '(min-width: 48em) 25vw, 50vw',
            alt: product.featured_image.alt
        }}
      {%- endif -%}
    </div>
    <div class="stack">
      {%- if product.vendor != blank -%}
        <p class="product-card__vendor">{{ product.vendor }}</p>
      {%- endif -%}
      <h3 class="product-card__title">{{ product.title }}</h3>
      <p class="product-card__price">{{ product.price | money }}</p>
    </div>
  </a>
  <div class="product-card__actions">
    {% if product.has_only_default_variant %}
      {% form 'product', product, class: 'product-card__form' %}
        <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
        <button class="btn btn--sm product-card__button" type="submit" {% unless product.available %}disabled{% endunless %}>
          {% if product.available %}Add{% else %}Sold out{% endif %}
        </button>
      {% endform %}
    {% else %}
      <a class="btn btn--sm product-card__button" href="{{ product.url }}">Choose Options</a>
    {% endif %}
    <button
      class="product-card__wishlist"
      type="button"
      data-wishlist-toggle
      data-product-id="{{ product.id }}"
      data-product-handle="{{ product.handle }}"
      aria-label="Add {{ product.title | escape }} to wishlist"
      aria-pressed="false"
    >
      <span aria-hidden="true">Save</span>
    </button>
  </div>
</article>
