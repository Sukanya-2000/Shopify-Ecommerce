{% if paginate.pages > 1 %}
  <nav class="pagination" role="navigation" aria-label="Pagination">
    {% if paginate.previous %}
      <a class="pagination__link" href="{{ paginate.previous.url }}">Previous</a>
    {% endif %}

    {% for part in paginate.parts %}
      {% if part.is_link %}
        <a class="pagination__link" href="{{ part.url }}">{{ part.title }}</a>
      {% else %}
        <span class="pagination__link{% if part.title == paginate.current_page %} is-current{% endif %}">{{ part.title }}</span>
      {% endif %}
    {% endfor %}

    {% if paginate.next %}
      <a class="pagination__link" href="{{ paginate.next.url }}">Next</a>
    {% endif %}
  </nav>
{% endif %}
