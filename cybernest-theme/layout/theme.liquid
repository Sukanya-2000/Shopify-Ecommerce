<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>{{ page_title }}</title>
    {% style %}
      {{ settings.font_body | font_face }}
      {%- unless settings.font_heading.family == settings.font_body.family -%}
        {{ settings.font_heading | font_face }}
      {%- endunless -%}
    {% endstyle %}
    {% render 'css-variables' %}
    {{ 'base.css' | asset_url | stylesheet_tag }}
    {{ 'header.css' | asset_url | stylesheet_tag }}
    {{ 'homepage.css' | asset_url | stylesheet_tag }}
    {{ 'product-page.css' | asset_url | stylesheet_tag }}
    {{ 'cart.css' | asset_url | stylesheet_tag }}
    <script src="{{ 'header.js' | asset_url }}" defer></script>
    <script src="{{ 'predictive-search.js' | asset_url }}" defer></script>
    <script src="{{ 'cart.js' | asset_url }}" defer></script>
    <script src="{{ 'product-form.js' | asset_url }}" defer></script>
    <script src="{{ 'wishlist.js' | asset_url }}" defer></script>
    {{ content_for_header }}
  </head>
  <body>
    {% section 'header' %}
    {% section 'header-mobile-nav' %}
    {{ content_for_layout }}
    {% render 'cart-drawer' %}
  </body>
</html>
